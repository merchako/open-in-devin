{
  "manifest_version": 3,
  "name": "Open in Devin",
  "version": "1.1",
  "description": "Open the current GitHub PR in Devin Review with one click",
  "permissions": ["activeTab", "scripting", "declarativeContent"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "Open in Devin",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "open-in-devin": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open current GitHub PR in Devin Review"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
