{
  "manifest_version": 3,
  "name": "Open in Devin",
  "version": "1.0",
  "description": "Open the current GitHub PR in Devin Review with one click",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Open in Devin",
    "default_icon": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
